---
import Layout from '../layouts/Layout.astro';
import { MapPin, Mail } from '@lucide/astro';
---

<Layout
  title="Nous trouver"
  description="Les bureaux de zatsit sont à Euratechnopolys, 2 allée de la Haye du Temple à Lille. Voici comment nous rejoindre."
  withAddress
>
  <section class="section--hero">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h1 class="section-title--lg text-center">
          Nous <span class="text-gradient">trouver</span>
        </h1>

        <div class="mt-12 grid md:grid-cols-2 gap-8">
          <div class="card p-6">
            <div class="flex items-start gap-3 mb-4">
              <MapPin class="icon-md icon-primary flex-shrink-0" size={20} />
              <div>
                <h2 class="item-title">Adresse</h2>
                <p class="item-description">
                  EURATECHNOPOLYS<br />
                  2 Allée de la Haye du Temple<br />
                  59160 Lille
                </p>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start gap-3 mb-4">
              <Mail class="icon-md icon-primary flex-shrink-0" size={20} />
              <div>
                <h2 class="item-title">Contact</h2>
                <a href="mailto:contact@zatsit.fr" class="link-primary">
                  contact@zatsit.fr
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
