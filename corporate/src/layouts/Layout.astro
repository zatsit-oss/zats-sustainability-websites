---
import { ViewTransitions } from 'astro:transitions';
import { BaseHead } from '@zatsit/components';
import { GITHUB_URL, LINKEDIN_URL } from 'astro:env/client';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  ADDRESS,
  SITE_DESCRIPTION,
  SITE_INLANGUAGE,
  SITE_LANG,
  SITE_LOCALE,
  SITE_LOGO,
  SITE_OG_IMAGE,
  SITE_OG_IMAGE_ALT,
  SITE_OG_IMAGE_HEIGHT,
  SITE_OG_IMAGE_WIDTH,
  SITE_TITLE,
} from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Trail from the root to this page, excluding the page itself. */
  breadcrumbs?: { name: string; href: string }[];
  /**
   * Attaches the postal address to the organisation. Set on `/find-us/`, the
   * page that actually publishes it with a map, and nowhere else.
   */
  withAddress?: boolean;
  /** Set on pages that exist without being content, such as the 404 body. */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  breadcrumbs = [],
  withAddress = false,
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={SITE_LANG}>
  <head>
    <BaseHead
      title={title}
      description={description}
      siteName={SITE_TITLE}
      siteDescription={SITE_DESCRIPTION}
      inLanguage={SITE_INLANGUAGE}
      locale={SITE_LOCALE}
      image={SITE_OG_IMAGE}
      imageAlt={SITE_OG_IMAGE_ALT}
      imageWidth={SITE_OG_IMAGE_WIDTH}
      imageHeight={SITE_OG_IMAGE_HEIGHT}
      logo={SITE_LOGO}
      sameAs={[LINKEDIN_URL, GITHUB_URL]}
      address={withAddress ? ADDRESS : undefined}
      breadcrumbs={breadcrumbs}
      sitemap="/sitemap.xml"
      noindex={noindex}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <ViewTransitions />

    <!-- Theme persistence -->
    <script is:inline>
      function applyTheme() {
        const theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">
      Aller au contenu principal
    </a>

    <Header />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
