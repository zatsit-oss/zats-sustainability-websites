---
import { BLOG_URL, LINKEDIN_URL, GITHUB_URL, SUSTAINABILITY_URL, ETI_RAPPORT_URL } from 'astro:env/client';
import Logo from './Logo.astro';
import GithubIcon from '../assets/icons/github.svg';
import LinkedinIcon from '../assets/icons/linkedin.svg';
import SustainabilityIcon from '../assets/icons/sustainability.svg';
import { CodeXml, Mail, MapPin } from '@lucide/astro';
import { Image } from 'astro:assets';
import ecovadisMedal from '../assets/ecovadis-medal.webp';
import BcorpBlack from '../assets/bcorp-black.svg';
import BcorpLight from '../assets/bcorp-light.svg';
---

<footer class="footer-main">
  <div class="container py-10 md:py-12">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_auto] gap-10 md:gap-16 justify-center">

      <!-- Col 1: Logo + Mission + Website Carbon -->
      <div>
        <div class="flex items-center gap-3 mb-3">
          <Logo class="h-8 w-auto icon-primary" />
          <span class="text-2xl font-semibold icon-primary leading-none">zatsit</span>
        </div>
        <p class="text-muted text-sm leading-relaxed">
          Engager notre <strong class="text-[var(--color-text)]">expertise numérique</strong> au service
          de l'<strong class="text-[var(--color-text)]">impact</strong> des entreprises, en créant un écosystème
          <strong class="text-[var(--color-text)]">durable</strong>, <strong class="text-[var(--color-text)]">partenarial</strong>
          et <strong class="text-[var(--color-text)]">positif</strong>.
        </p>
        <div class="mt-4">
          <div id="wcb" class="carbonbadge wcb"></div>
          <script src="https://unpkg.com/website-carbon-badges@1.1.3/b.min.js" defer></script>
          <script>
            function syncCarbonBadgeTheme() {
              const badge = document.getElementById('wcb');
              if (!badge) return;
              const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
              badge.classList.toggle('wcb', !isDark);
              badge.classList.toggle('wcb-d', isDark);
            }

            function initCarbonBadgeThemeSync() {
              syncCarbonBadgeTheme();
              const toggleBtn = document.getElementById('theme-toggle');
              toggleBtn?.removeEventListener('click', onThemeToggleClick);
              toggleBtn?.addEventListener('click', onThemeToggleClick);
            }

            function onThemeToggleClick() {
              setTimeout(syncCarbonBadgeTheme, 0);
            }

            initCarbonBadgeThemeSync();
            document.addEventListener('astro:after-swap', initCarbonBadgeThemeSync);
          </script>
        </div>
      </div>

      <!-- Col 2: Contact + social icons, in the header's order: the two
           sibling sites, then LinkedIn, GitHub, mail. -->
      <div>
        <h2 class="font-semibold mb-3">Nous trouver</h2>
        <div class="text-sm text-muted space-y-2">
          <div class="flex items-start gap-2">
            <MapPin class="icon-sm mt-0.5 shrink-0" size={16} />
            <span>
              EURATECHNOPOLYS<br />
              2 Allée de la Haye du Temple<br />
              59160 Lille
            </span>
          </div>
        </div>
        <ul class="flex flex-wrap gap-3 mt-4 list-none p-0">
          <li>
            <a href={BLOG_URL} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Notre blog, dans un nouvel onglet">
              <CodeXml class="icon-md" aria-hidden="true" />
            </a>
          </li>
          <li>
            <a href={SUSTAINABILITY_URL} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Le portail Sustainability, dans un nouvel onglet">
              <SustainabilityIcon class="icon-md" aria-hidden="true" />
            </a>
          </li>
          <li>
            <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Notre page LinkedIn, dans un nouvel onglet">
              <LinkedinIcon class="icon-md" aria-hidden="true" />
            </a>
          </li>
          <li>
            <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Notre GitHub, dans un nouvel onglet">
              <GithubIcon class="icon-md" aria-hidden="true" />
            </a>
          </li>
          <li>
            <a href="mailto:contact@zatsit.fr" class="footer-social-link" aria-label="Écrire à contact@zatsit.fr">
              <Mail class="icon-md" aria-hidden="true" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: EcoVadis + B Corp -->
      <div class="flex items-center justify-center md:justify-start gap-4">
        <Image src={ecovadisMedal} alt="EcoVadis Silver Medal - Top 15%" width={84} height={84} class="opacity-90" />
        <a href="https://www.bcorporation.net/" target="_blank" rel="noopener noreferrer" aria-label="Certification B Corp">
          <BcorpBlack class="bcorp-badge-black" width={76} height={116} />
          <BcorpLight class="bcorp-badge-light" width={76} height={116} />
        </a>
      </div>
    </div>
  </div>

  <!-- Copyright bar -->
  <div class="border-t" style="border-color: var(--color-border);">
    <div class="container py-4 flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-muted">
      <p>zatsit - {new Date().getFullYear()} &bull; Site statique éco-conçu</p>
      <div class="flex gap-6">
        <a href={ETI_RAPPORT_URL} target="_blank" rel="noopener noreferrer" class="link">Rapport ETI</a>
        <a href="/legal-notice/" class="link">Mentions légales</a>
        <a href="/privacy-policy/" class="link">Politique de confidentialité</a>
      </div>
    </div>
  </div>
</footer>
