---
import { BaseHead, Header, Footer } from '@zatsit/components';
import { ZATSIT_WEBSITE_URL, BLOG_URL, GITHUB_URL, LINKEDIN_URL } from 'astro:env/client';
import {
  SITE_DESCRIPTION,
  SITE_INLANGUAGE,
  SITE_LANG,
  SITE_LOCALE,
  SITE_LOGO,
  SITE_OG_IMAGE,
  SITE_OG_IMAGE_ALT,
  SITE_TITLE,
} from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Trail from the root to this page, excluding the page itself. */
  breadcrumbs?: { name: string; href: string }[];
  /** Set on pages that exist without being content, such as the 404 body. */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  breadcrumbs = [],
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <BaseHead
      title={title}
      description={description}
      siteName={SITE_TITLE}
      siteDescription={SITE_DESCRIPTION}
      inLanguage={SITE_INLANGUAGE}
      locale={SITE_LOCALE}
      image={SITE_OG_IMAGE}
      imageAlt={SITE_OG_IMAGE_ALT}
      imageWidth={1200}
      imageHeight={630}
      logo={SITE_LOGO}
      sameAs={[LINKEDIN_URL, GITHUB_URL]}
      breadcrumbs={breadcrumbs}
      sitemap="/sitemap.xml"
      noindex={noindex}
    />
    <link rel="icon" href="/favicon.ico" />

    <!-- Applied before first paint so the page never flashes the wrong theme.
         The attribute, the storage key and the fallback all match corporate. -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', stored ?? (prefersDark ? 'dark' : 'light'));
        } catch {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Theme changes are announced here, the toggle only dispatches the text. -->
    <div id="announcement" aria-live="polite" role="status" class="sr-only"></div>

    <Header
      website_url={ZATSIT_WEBSITE_URL}
      blog_url={BLOG_URL}
      linkedin_url={LINKEDIN_URL}
      github_url={GITHUB_URL}
    />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer
      website_url={ZATSIT_WEBSITE_URL}
      blog_url={BLOG_URL}
      linkedin_url={LINKEDIN_URL}
      github_url={GITHUB_URL}
    />

    <script>
      document.addEventListener('announcement', (e) => {
        const el = document.getElementById('announcement');
        if (el) el.textContent = (e as CustomEvent<string>).detail;
      });
    </script>
  </body>
</html>
