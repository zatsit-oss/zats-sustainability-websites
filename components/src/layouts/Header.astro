---
/**
 * Site header, the same bar as corporate, the blog and the tech watcher, so a
 * visitor moving between the four zatsit sites never re-learns it. Corporate's
 * `Header.astro` is the reference; this file follows it, and the metrics live
 * in the portal's global.css under "Header".
 *
 * Left to right, and in this order everywhere:
 *   1. brand: sigle plus the "zatsit" wordmark, the wordmark only from `lg`
 *   2. page navigation, collapsed behind the menu button below `lg`
 *   3. ecosystem icons, always visible: the two sibling sites, then LinkedIn,
 *      GitHub, mail
 *   4. theme toggle
 *   5. menu button, below `lg` only
 *
 * Only the navigation entries and the two sibling sites differ from site to
 * site. Here the siblings are the corporate website and the blog.
 *
 * This site keeps its English wording; the shape is what is shared, not the
 * copy.
 */
import ThemeToggle from './ThemeToggle.astro';
import GlobeIcon from '../assets/globe.svg';
import LinkedinIcon from '../assets/linkedin.svg';
import GithubIcon from '../assets/github.svg';
import BlogIcon from '../assets/blog.svg';
import MailIcon from '../assets/mail.svg';
import MenuIcon from '../assets/menu.svg';
import CloseIcon from '../assets/close.svg';
import ExternalLinkIcon from '../assets/external-link.svg';

interface Props {
  website_url: string;
  blog_url: string;
  linkedin_url: string;
  github_url: string;
  contact_email?: string;
}

const {
  website_url,
  blog_url,
  linkedin_url,
  github_url,
  contact_email = 'contact@zatsit.fr',
} = Astro.props;

/**
 * The landscape is generated by landscape2 into /landscape: it is a separate
 * application with its own styling, carrying neither this header nor this
 * footer. Hence the marker and the new tab, which is also how a visitor gets
 * back here.
 */
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/greenscore', label: 'Green Score' },
  { href: '/landscape', label: 'Landscape', external: true },
];

/** `/` matches exactly, the rest by prefix, and a trailing slash never matters. */
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string, external = false) =>
  external ? false : href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header glass" role="banner">
  <nav class="container header-nav" aria-label="Main navigation">
    <a href="/" class="header-brand" aria-label="zatsit, portal home">
      <svg
        class="header-logo fill-current"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 512.005 512.005"
        aria-hidden="true"
      >
        <path d="m302.16,316.77c-76.98,1.24-140.96,50.21-163.47,121.28,26.49,10.8,55.44,16.8,85.8,16.8,93.98,0,174.63-57.01,209.29-138.33-43.88-.18-87.76-.46-131.62.25"/>
        <path d="m152.86,138.35c78.19-.88,143.48-49.69,166.39-117.65C290.4,7.44,258.32,0,224.49,0,130.46,0,49.76,57.07,15.13,138.47c45.91.12,91.83.4,137.73-.12"/>
        <path d="m392.21,266.63c25.47-15.7,45.13-34.74,58.96-56.8-5.67-74.07-46.77-138.18-106.44-175.43-38.91,79.79-77.95,159.83-117.46,240.83,57.07,25.19,112.59,23.67,164.94-8.61"/>
        <path d="m6.12,251.54c-2.24,4.03-4.24,8.14-6.12,12.28,11.17,69.43,53.77,128.31,112.75,161.65,40.07-82.16,79.93-163.88,119.75-245.53-56.89-34.36-172.23-25.87-226.38,71.59"/>
      </svg>
      <span class="header-wordmark">zatsit</span>
    </a>

    <ul class="header-links">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={isCurrent(link.href, link.external) ? 'link-primary' : 'nav-link'}
            aria-current={isCurrent(link.href, link.external) ? 'page' : undefined}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
            {link.external && (
              <>
                <ExternalLinkIcon class="icon-sm inline-block ml-1 align-middle" />
                <span class="sr-only">, in a new tab</span>
              </>
            )}
          </a>
        </li>
      ))}
    </ul>

    <div class="header-actions">
      <ul class="header-ecosystem">
        <li>
          <a
            href={website_url}
            target="_blank"
            rel="noopener noreferrer"
            class="header-action"
            aria-label="The zatsit website, in a new tab"
          >
            <GlobeIcon class="icon-md" />
          </a>
        </li>
        <li>
          <a
            href={blog_url}
            target="_blank"
            rel="noopener noreferrer"
            class="header-action"
            aria-label="The tech blog, in a new tab"
          >
            <BlogIcon class="icon-md" />
          </a>
        </li>
        <li>
          <a
            href={linkedin_url}
            target="_blank"
            rel="noopener noreferrer"
            class="header-action"
            aria-label="LinkedIn, in a new tab"
          >
            <LinkedinIcon class="icon-md" />
          </a>
        </li>
        <li>
          <a
            href={github_url}
            target="_blank"
            rel="noopener noreferrer"
            class="header-action"
            aria-label="GitHub, in a new tab"
          >
            <GithubIcon class="icon-md" />
          </a>
        </li>
        <li>
          <a
            href={`mailto:${contact_email}`}
            class="header-action"
            aria-label={`Email us at ${contact_email}`}
          >
            <MailIcon class="icon-md" />
          </a>
        </li>
      </ul>

      <ThemeToggle />

      <button
        id="mobile-menu-btn"
        class="mobile-menu-btn"
        type="button"
        aria-label="Open the menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <MenuIcon class="icon-md menu-open-icon" />
        <CloseIcon class="icon-md menu-close-icon hidden" />
      </button>
    </div>
  </nav>

  {/* Navigation only: the ecosystem icons and the mail link stay in the bar at
      every width, so repeating them here would be a duplicate. */}
  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul class="container mobile-menu-content">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={isCurrent(link.href, link.external) ? 'link-primary text-lg py-2' : 'mobile-nav-link'}
            aria-current={isCurrent(link.href, link.external) ? 'page' : undefined}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
            {link.external && (
              <>
                <ExternalLinkIcon class="icon-sm inline-block ml-1 align-middle" />
                <span class="sr-only">, in a new tab</span>
              </>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.querySelector('.menu-open-icon');
    const closeIcon = document.querySelector('.menu-close-icon');
    if (!btn || !menu) return;

    // The label follows the state, so a screen reader announces what the next
    // click does rather than what the button opened last time.
    function setOpen(open: boolean) {
      btn!.setAttribute('aria-expanded', String(open));
      btn!.setAttribute('aria-label', open ? 'Close the menu' : 'Open the menu');
      (menu as HTMLElement).hidden = !open;
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    }

    setOpen(false);
    btn.addEventListener('click', () => {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes the panel and hands focus back, so a keyboard user is never
    // stranded inside something they cannot see.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || btn.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      btn.focus();
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
